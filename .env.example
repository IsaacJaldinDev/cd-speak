# Copy this file to `.env` and fill in the real values.
#
# LaunchDarkly client-side ID for your environment (Project settings →
# Environments → Client-side ID). Not a secret per LaunchDarkly's design —
# it's meant to be exposed in the browser bundle — but keeping it out of
# the repo lets you rotate it or switch environments without a code change.
LD_CLIENT_SIDE_ID=your_launchdarkly_client_side_id_here
